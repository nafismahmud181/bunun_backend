# Copy to .env and fill in. Never commit .env.

# --- Database: Supabase (Project → Connect → ORM / "Connection string") ---
# App runtime: TRANSACTION pooler, port 6543. Verifies Supabase's certificate (download it from
# Project Settings → Database → SSL configuration, save as certs/supabase-ca.crt).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt"
# Migrations only (prisma migrate): SESSION pooler, port 5432 (or the direct connection if you have IPv6).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Database: local Docker instead (npm run db:up) — use these two lines and delete the ones above ---
# DATABASE_URL="postgresql://bunun:bunun@localhost:5433/bunun"
# DIRECT_URL="postgresql://bunun:bunun@localhost:5433/bunun"

PORT=4000
HOST=0.0.0.0
# Comma-separated origins allowed to call the API
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
LOG_LEVEL=info

# Storefront address, used in SMS links (e.g. the track-order page)
STOREFRONT_URL=http://localhost:3000
# SMS: "log" writes messages to the log instead of sending (until an SMS provider account is ready)
SMS_DRIVER=log
# "inline" sends queued SMS from the API process; "off" if you run `npm run worker` separately
SMS_WORKER=inline
# Per-IP request limits ("off" only for tests)
RATE_LIMIT=on
