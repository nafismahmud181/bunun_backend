# Copy to .env and fill in. Never commit .env.

# --- Database: the local Docker PostgreSQL (npm run db:up). Development never uses production. ---
# Outside production the API and scripts refuse any database that isn't on this computer
# (ALLOW_REMOTE_DATABASE=true overrides that for one deliberate command).
DATABASE_URL="postgresql://bunun:bunun@localhost:5433/bunun"
DIRECT_URL="postgresql://bunun:bunun@localhost:5433/bunun"

# --- Production (Supabase) belongs in Coolify and in .env.production (git-ignored), never here: ---
# DATABASE_URL: TRANSACTION pooler, port 6543, verified against certs/supabase-ca.crt:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt
# DIRECT_URL (migrations only): SESSION pooler, port 5432:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

PORT=4000
HOST=0.0.0.0
# Comma-separated origins allowed to call the API
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
LOG_LEVEL=info

# Storefront address, used in SMS links (e.g. the track-order page)
STOREFRONT_URL=http://localhost:3000
# SMS: "log" writes messages to the log instead of sending (until an SMS provider account is ready)
SMS_DRIVER=log
# "inline" sends queued SMS from the API process; "off" if you run `npm run worker` separately
SMS_WORKER=inline
# Per-IP request limits ("off" only for tests)
RATE_LIMIT=on
# Comma-separated client IPs exempt from the per-IP limits (e.g. a load-test machine). Leave empty normally.
RATE_LIMIT_ALLOWLIST=

# Which proxies may set X-Forwarded-For: "loopback" (Caddy or the admin panel on the same machine), "true", "false", or IPs.
# "true" (and RATE_LIMIT=off) are refused in production.
TRUST_PROXY=loopback
# Encrypts admin two-factor secrets. Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_ENCRYPTION_KEY=

# Image storage (Supabase Storage). Create the bucket once with: npm run storage:setup
SUPABASE_URL=https://<project-ref>.supabase.co
# A Supabase "secret" key (sb_secret_…, Project Settings → API Keys). Server only; never in a browser.
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=product-images
# Shared with the storefront (its .env.local): lets the API refresh the storefront cache after admin changes
REVALIDATE_SECRET=

# Pathao courier. Leave the credentials empty to switch booking off. The sandbox below accepts
# Pathao's published test account (client 7N1aMJQbWm, test@pathao.com / lovePathao); for live use
# https://api-hermes.pathao.com and the credentials from Pathao Merchant → Developer's API.
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
# Pickup store (Pathao Merchant → Stores); empty uses the account's default store
PATHAO_STORE_ID=
# The secret you enter in Pathao Merchant → Developer's API → Webhook (Callback URL: https://<api>/api/v1/webhooks/pathao)
PATHAO_WEBHOOK_SECRET=
# Minutes between status checks of open parcels (the webhook usually updates them sooner)
COURIER_SYNC_MINUTES=15

# --- Error tracking (Sentry, free plan): sentry.io → project → Settings → Client Keys (DSN). Off when empty ---
SENTRY_DSN=
# e.g. staging or production
SENTRY_ENVIRONMENT=
