// Schema v1: catalogue only. Orders, customers and payments arrive in Phase 2.
// Money is stored as whole taka (Int).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  draft
  active
  archived
}

model Category {
  id        Int       @id @default(autoincrement())
  nameEn    String    @map("name_en")
  nameBn    String?   @map("name_bn")
  slug      String    @unique
  imageUrl  String?   @map("image_url")
  sort      Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id             Int              @id @default(autoincrement())
  slug           String           @unique
  // Old storefront id (e.g. "r1"), kept so /product/r1 can redirect to the slug URL.
  legacyId       String?          @unique @map("legacy_id")
  nameEn         String           @map("name_en")
  nameBn         String?          @map("name_bn")
  descriptionEn  String?          @map("description_en")
  descriptionBn  String?          @map("description_bn")
  categoryId     Int              @map("category_id")
  category       Category         @relation(fields: [categoryId], references: [id])
  tag            String?
  status         ProductStatus    @default(draft)
  seoTitle       String?          @map("seo_title")
  seoDescription String?          @map("seo_description")
  variants       ProductVariant[]
  images         ProductImage[]
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([categoryId, status])
  @@map("products")
}

model ProductVariant {
  id             Int                 @id @default(autoincrement())
  sku            String              @unique
  productId      Int                 @map("product_id")
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  label          String
  price          Int
  compareAtPrice Int?                @map("compare_at_price")
  stock          Int                 @default(0)
  weightGrams    Int?                @map("weight_grams")
  sort           Int                 @default(0)
  movements      InventoryMovement[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sort      Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

// Every stock change is recorded here; `stock` on the variant is the running total.
model InventoryMovement {
  id        Int            @id @default(autoincrement())
  variantId Int            @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change    Int
  reason    String
  orderId   Int?           @map("order_id")
  adminId   Int?           @map("admin_id")
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([variantId, createdAt])
  @@map("inventory_movements")
}
