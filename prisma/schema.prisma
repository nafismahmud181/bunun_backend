// Schema v1: catalogue only. Orders, customers and payments arrive in Phase 2.
// Money is stored as whole taka (Int).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  draft
  active
  archived
}

model Category {
  id        Int       @id @default(autoincrement())
  nameEn    String    @map("name_en")
  nameBn    String?   @map("name_bn")
  slug      String    @unique
  imageUrl  String?   @map("image_url")
  sort      Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id             Int                   @id @default(autoincrement())
  slug           String                @unique
  // Old storefront id (e.g. "r1"), kept so /product/r1 can redirect to the slug URL.
  legacyId       String?               @unique @map("legacy_id")
  nameEn         String                @map("name_en")
  nameBn         String?               @map("name_bn")
  descriptionEn  String?               @map("description_en")
  descriptionBn  String?               @map("description_bn")
  categoryId     Int                   @map("category_id")
  category       Category              @relation(fields: [categoryId], references: [id])
  tag            String?
  status         ProductStatus         @default(draft)
  seoTitle       String?               @map("seo_title")
  seoDescription String?               @map("seo_description")
  // Lowest variant price, stored so listings can filter and sort by price in SQL.
  // Keep in sync with refreshPriceFrom() whenever variants change.
  priceFrom      Int                   @default(0) @map("price_from")
  variants       ProductVariant[]
  images         ProductImage[]
  sectionItems   HomepageSectionItem[]
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@index([categoryId, status])
  @@index([status, priceFrom])
  @@map("products")
}

// Hand-picked product lists on the homepage (e.g. "bestsellers", "new-arrivals").
model HomepageSection {
  key   String                @id
  title String
  items HomepageSectionItem[]

  @@map("homepage_sections")
}

model HomepageSectionItem {
  sectionKey String          @map("section_key")
  section    HomepageSection @relation(fields: [sectionKey], references: [key], onDelete: Cascade)
  productId  Int             @map("product_id")
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sort       Int             @default(0)

  @@id([sectionKey, productId])
  @@index([sectionKey, sort])
  @@map("homepage_section_items")
}

model ProductVariant {
  id             Int                 @id @default(autoincrement())
  sku            String              @unique
  productId      Int                 @map("product_id")
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  label          String
  price          Int
  compareAtPrice Int?                @map("compare_at_price")
  stock          Int                 @default(0)
  weightGrams    Int?                @map("weight_grams")
  sort           Int                 @default(0)
  movements      InventoryMovement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sort      Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

// Every stock change is recorded here; `stock` on the variant is the running total.
model InventoryMovement {
  id        Int            @id @default(autoincrement())
  variantId Int            @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change    Int
  reason    String
  orderId   Int?           @map("order_id")
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  adminId   Int?           @map("admin_id")
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

// ---------- Locations and delivery ----------
// Divisions, districts and upazilas come from the open nuhil/bangladesh-geocode dataset (MIT),
// keeping the dataset's ids. Dhaka city thanas are added separately, with ids from 10001.

model Division {
  id        Int        @id
  nameEn    String     @map("name_en")
  nameBn    String?    @map("name_bn")
  districts District[]

  @@map("divisions")
}

model District {
  id         Int      @id
  divisionId Int      @map("division_id")
  division   Division @relation(fields: [divisionId], references: [id])
  nameEn     String   @map("name_en")
  nameBn     String?  @map("name_bn")
  // Delivery zone for areas in this district that don't set their own.
  zoneKey    String?  @map("zone_key")
  areas      Area[]

  @@index([divisionId])
  @@map("districts")
}

// An upazila or city thana.
model Area {
  id         Int      @id
  districtId Int      @map("district_id")
  district   District @relation(fields: [districtId], references: [id])
  nameEn     String   @map("name_en")
  nameBn     String?  @map("name_bn")
  zoneKey    String?  @map("zone_key")
  sort       Int      @default(0)

  @@index([districtId])
  @@map("areas")
}

model DeliveryZone {
  key      String @id
  name     String
  fee      Int
  estimate String
  sort     Int    @default(0)

  @@map("delivery_zones")
}

// Store-wide settings as key and JSON value (free-delivery threshold, hotline, and so on).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ---------- Carts ----------

// A guest cart. The browser keeps a random token; only its SHA-256 hash is stored.
model Cart {
  id         Int        @id @default(autoincrement())
  tokenHash  String     @unique @map("token_hash")
  customerId Int?       @map("customer_id")
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items      CartItem[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  cartId    Int            @map("cart_id")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId Int            @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int
  addedAt   DateTime       @default(now()) @map("added_at")

  @@id([cartId, variantId])
  @@map("cart_items")
}

// ---------- Customers and orders ----------

model Customer {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  name      String
  email     String?
  // Internal staff notes about the customer (never shown to them).
  notes     String?
  orders    Order[]
  carts     Cart[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customers")
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  returned
  refunded
}

enum PaymentStatus {
  unpaid
  partially_paid
  paid
  refunded
}

enum PaymentMethod {
  cod
  bkash
  nagad
  card
}

model Order {
  id             Int                  @id @default(autoincrement())
  // From the order_no_seq sequence, e.g. BN-2026-000123.
  orderNo        String               @unique @map("order_no")
  customerId     Int                  @map("customer_id")
  customer       Customer             @relation(fields: [customerId], references: [id])
  // Contact and address as entered, kept even if the customer or locations change later.
  name           String
  phone          String
  divisionName   String               @map("division_name")
  districtName   String               @map("district_name")
  areaName       String               @map("area_name")
  areaId         Int?                 @map("area_id")
  addressLine    String               @map("address_line")
  zoneKey        String               @map("zone_key")
  subtotal       Int
  discount       Int                  @default(0)
  deliveryFee    Int                  @map("delivery_fee")
  total          Int
  status         OrderStatus          @default(pending)
  paymentStatus  PaymentStatus        @default(unpaid) @map("payment_status")
  paymentMethod  PaymentMethod        @map("payment_method")
  notes          String?
  ip             String?
  userAgent      String?              @map("user_agent")
  // "web", or where staff took a manual order: "facebook", "whatsapp", "phone", "other".
  source         String               @default("web")
  // The admin who entered a manual order.
  createdById    Int?                 @map("created_by_id")
  createdBy      AdminUser?           @relation("OrdersEntered", fields: [createdById], references: [id], onDelete: SetNull)
  idempotencyKey String               @unique @map("idempotency_key")
  items          OrderItem[]
  history        OrderStatusHistory[]
  smsMessages    SmsMessage[]
  movements      InventoryMovement[]
  staffNotes     OrderNote[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

// Name, SKU, label and price are copied at order time.
model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int             @map("order_id")
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   Int?            @map("variant_id")
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku         String
  productName String          @map("product_name")
  label       String
  unitPrice   Int             @map("unit_price")
  qty         Int
  lineTotal   Int             @map("line_total")

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         Int          @id @default(autoincrement())
  orderId    Int          @map("order_id")
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?
  // "system", "customer", or an admin reference once admin accounts exist.
  actor      String
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// Phone numbers or IPs that may not place orders online.
model BlockedContact {
  id        Int      @id @default(autoincrement())
  kind      String // "phone" or "ip"
  value     String
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([kind, value])
  @@map("blocked_contacts")
}

// ---------- Messaging ----------

enum SmsStatus {
  queued
  sent
  failed
}

// Outbox: rows are written in the same transaction as the order, then sent by the worker.
model SmsMessage {
  id            Int       @id @default(autoincrement())
  to            String
  body          String
  template      String
  status        SmsStatus @default(queued)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  providerRef   String?   @map("provider_ref")
  orderId       Int?      @map("order_id")
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@map("sms_messages")
}

// ---------- Admin ----------

enum AdminRole {
  owner
  manager
  order_handler
  content_editor
}

// Staff accounts for the admin panel. Two-factor authentication (TOTP) is mandatory.
model AdminUser {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String
  passwordHash  String         @map("password_hash")
  role          AdminRole
  // TOTP secret, encrypted with ADMIN_ENCRYPTION_KEY (AES-256-GCM).
  totpSecret    String?        @map("totp_secret")
  totpEnabled   Boolean        @default(false) @map("totp_enabled")
  // Time step of the last accepted code, so a code can't be used twice.
  totpLastStep  Int?           @map("totp_last_step")
  active        Boolean        @default(true)
  failedLogins  Int            @default(0) @map("failed_logins")
  lockedUntil   DateTime?      @map("locked_until")
  lastLoginAt   DateTime?      @map("last_login_at")
  sessions      AdminSession[]
  auditLogs     AuditLog[]
  orderNotes    OrderNote[]
  ordersEntered Order[]        @relation("OrdersEntered")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("admin_users")
}

enum AdminSessionStage {
  // Password accepted; the admin must set up two-factor authentication.
  two_factor_setup
  // Password accepted; waiting for the authenticator code.
  two_factor
  // Fully signed in.
  active
}

// Sessions are opaque random tokens; only their SHA-256 hash is stored, so they can be revoked.
model AdminSession {
  id          Int               @id @default(autoincrement())
  tokenHash   String            @unique @map("token_hash")
  adminId     Int               @map("admin_id")
  admin       AdminUser         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  stage       AdminSessionStage
  failedCodes Int               @default(0) @map("failed_codes")
  ip          String?
  userAgent   String?           @map("user_agent")
  createdAt   DateTime          @default(now()) @map("created_at")
  lastSeenAt  DateTime          @default(now()) @map("last_seen_at")
  expiresAt   DateTime          @map("expires_at")

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

// Who did what in the admin panel, and when.
model AuditLog {
  id         Int        @id @default(autoincrement())
  adminId    Int?       @map("admin_id")
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  entityType String?    @map("entity_type")
  entityId   String?    @map("entity_id")
  data       Json?
  ip         String?
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([adminId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// Internal notes on an order, visible only to staff.
model OrderNote {
  id        Int        @id @default(autoincrement())
  orderId   Int        @map("order_id")
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminId   Int?       @map("admin_id")
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_notes")
}
